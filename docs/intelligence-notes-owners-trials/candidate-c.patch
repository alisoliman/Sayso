+    static func existingNotesLabels(_ transcript: String) -> [String]? {
+        let lines = transcript.components(separatedBy: .newlines).filter { !$0.trimmingCharacters(in: .whitespaces).isEmpty }
+        guard !lines.isEmpty, lines.allSatisfy({ $0.range(of: #"^[-*•]\s+\S"#, options: .regularExpression) != nil }) else { return nil }
+        let pattern = try! NSRegularExpression(pattern: #"^[-*•]\s+([\p{L}][\p{L}\s'’–-]{0,60}):\s+\S"#)
+        return lines.compactMap { line in
+            guard let match = pattern.firstMatch(in: line, range: NSRange(line.startIndex..., in: line)), let range = Range(match.range(at: 1), in: line) else { return nil }
+            return String(line[range])
+        }
+    }
+
+    static func restoringLiteralNoteLabels(in items: [String], source: String) -> [String] {
+        guard existingNotesLabels(source) != nil else { return items }
+        let lines = source.components(separatedBy: .newlines).filter { !$0.trimmingCharacters(in: .whitespaces).isEmpty }
+        guard lines.count == items.count else { return items }
+        let labelPattern = try! NSRegularExpression(pattern: #"^([\p{L}][\p{L}\s'’–-]{0,60}):\s+(\S.*)$"#)
+        func words(_ text: String) -> [String] {
+            text.lowercased().components(separatedBy: CharacterSet.alphanumerics.inverted).filter { !$0.isEmpty }
+        }
+        var restored: [String] = []
+        for (line, output) in zip(lines, items) {
+            let original = withoutListMarkers(line).trimmingCharacters(in: .whitespaces)
+            let edited = withoutListMarkers(output).trimmingCharacters(in: .whitespacesAndNewlines)
+            if words(original) == words(edited) { restored.append(output); continue }
+            guard let match = labelPattern.firstMatch(in: original, range: NSRange(original.startIndex..., in: original)),
+                  let labelRange = Range(match.range(at: 1), in: original), let bodyRange = Range(match.range(at: 2), in: original),
+                  !words(String(original[bodyRange])).isEmpty,
+                  words(String(original[bodyRange])) == words(edited) else { return items }
+            restored.append(String(original[labelRange]) + ": " + edited)
+        }
+        return restored
+    }
