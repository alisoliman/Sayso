+    static func existingNotesLabels(_ transcript: String) -> [String]? {
+        let lines = transcript.components(separatedBy: .newlines).filter { !$0.trimmingCharacters(in: .whitespaces).isEmpty }
+        guard !lines.isEmpty, lines.allSatisfy({ $0.range(of: #"^[-*•]\s+\S"#, options: .regularExpression) != nil }) else { return nil }
+        let pattern = try! NSRegularExpression(pattern: #"^[-*•]\s+([\p{L}][\p{L}\s'’–-]{0,60}):\s+\S"#)
+        return lines.compactMap { line in
+            guard let match = pattern.firstMatch(in: line, range: NSRange(line.startIndex..., in: line)), let range = Range(match.range(at: 1), in: line) else { return nil }
+            return String(line[range])
+        }
+    }
